{
  "name": "dsh-web-search-duckduckgo",
  "version": "0.1.4",
  "description": "DSH plugin: DuckDuckGo-backed web search provider for ctx.web (no API key)",
  "type": "module",
  "main": "index.mjs",
  "exports": {
    ".": "./index.mjs",
    "./package.json": "./package.json"
  },
  "files": [
    "index.mjs",
    "cordis.patch.yml",
    "README.md"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tadreamk/web-search-duckduckgo.git"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "duckduckgo",
    "web-search",
    "plugin"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/dsh-web": "^0.1.2-rc.1",
    "@deepseek-ai/schemastery": "^3.18.1"
  },
  "engines": {
    "node": ">=20"
  }
}
